{
  "name": "codex-session-repair-middleware",
  "version": "0.1.0",
  "description": "Magpie 网关中间件：可独立开关的 Codex 会话资源清理，仅清理请求副本，默认关闭；启用后可能丢失加密或压缩上下文",
  "type": "module",
  "scripts": {
    "test": "node --test test/middleware.test.mjs test/session-repair.test.mjs test/package.test.mjs",
    "test:engine": "go -C test/engine test -count=1 ./...",
    "bench:engine": "go -C test/engine test -run ^$ -bench Request -benchmem ./..."
  },
  "files": [
    "codex-session-repair.middleware.js",
    "session-repair.mjs",
    "options.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "codex",
    "responses",
    "session-repair",
    "llm-gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZhaoJun233/codex-session-repair-middleware.git"
  },
  "magpie": {
    "middleware": "./codex-session-repair.middleware.js",
    "options": {
      "enabled": false
    }
  }
}
